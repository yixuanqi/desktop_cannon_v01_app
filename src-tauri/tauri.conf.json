{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "桌面小炮",
  "version": "0.2.0",
  "identifier": "com.ceer.desktopcannon",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "main-capabilities"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "一个可以把炮弹打过整个桌面的可爱小炮"
  }
}
